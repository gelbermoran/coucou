    },
    "Chats are kept in a private file on this Mac and never leave it, except the messages you send to the model you choose. Turn this off to forget them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats se guardan en un archivo privado de este Mac y nunca salen de él, salvo los mensajes que envías al modelo que elijas. Desactívalo para olvidarlos."
          }
        }
      }
