          }
        }
      }
    },
    "Everything Mochi does is written to agent.log: what it sent to the model, the actions it asked for and their results. API keys are never logged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hace Mochi se escribe en agent.log: lo que envió al modelo, las acciones que pidió y sus resultados. Las claves API nunca se registran."
          }
        }
      }
    },
