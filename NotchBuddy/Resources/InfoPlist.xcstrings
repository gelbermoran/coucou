{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To jump to the terminal, send emails and control Music."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para saltar al terminal, enviar correos y controlar Música."
          }
        }
      }
    },
    "NSAccessibilityUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read the active window title and attach it as context."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para leer el título de la ventana activa y adjuntarlo como contexto."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear your voice questions and answer you out loud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escuchar tus preguntas por voz y responderte hablando."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read your calendar and schedule meetings when you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para leer tu calendario y agendar reuniones cuando lo pidas."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add tasks to your Reminders when you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir tareas a tus Recordatorios cuando lo pidas."
          }
        }
      }
    }
  },
  "version": "1.0"
}